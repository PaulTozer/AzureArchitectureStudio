# Copy to .env.local and fill in the values from your Entra ID SPA app registration.
#
# How to create the app registration:
#   1. Azure Portal -> Microsoft Entra ID -> App registrations -> New registration
#   2. Supported account types: "Accounts in any organizational directory" (multitenant)
#   3. Platform: Single-page application (SPA)
#   4. Redirect URI: http://localhost:5173 (and your prod URL)
#   5. API permissions -> Add: Azure Service Management -> user_impersonation (delegated)
#   6. Grant admin consent (or let users consent on first sign-in)
#
# Then copy the Application (client) ID below.

VITE_AZURE_CLIENT_ID=
# Use 'organizations' for any work/school account, 'common' to also allow MSA,
# or a specific tenant GUID to restrict to one tenant.
VITE_AZURE_TENANT_ID=organizations
